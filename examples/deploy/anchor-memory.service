# systemd user unit. Copy to ~/.config/systemd/user/anchor-memory.service, then:
#   systemctl --user daemon-reload && systemctl --user enable --now anchor-memory
#   loginctl enable-linger $USER   # keep it running after you log out
[Unit]
Description=Anchor Memory (REST 8765 + MCP 8768, localhost only)
After=network-online.target

[Service]
WorkingDirectory=%h/anchor-memory
ExecStart=%h/anchor-memory/examples/deploy/start.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
